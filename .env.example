# ==========================================
# DirectHarvest AI - Environment Configuration
# ==========================================

# Application Environment ("development" or "production")
APP_NAME="DirectHarvest AI"
APP_ENV=development
PORT=7860
DEBUG=True

# Public Base URL (Must use HTTPS in production, e.g. https://your-service.onrender.com)
BASE_URL=http://localhost:7860

# Database Connection (MySQL via PyMySQL)
# Local development format:
DATABASE_URL=mysql+pymysql://root:root@localhost:3306/directharvest?charset=utf8mb4
# Production Aiven Cloud MySQL format:
# DATABASE_URL=mysql+pymysql://avnadmin:<password>@<aiven-db-host>:<port>/defaultdb?charset=utf8mb4

# Aiven Cloud MySQL TLS/SSL CA Certificate
# Path to the CA certificate file (defaults to ca.pem at the project root)
AIVEN_CA_PATH=ca.pem
# Alternatively on Render, you can supply the PEM certificate contents directly in an environment variable:
# AIVEN_CA_CERT=

# Authentication & Security
# In production, SECRET_KEY must be at least 32 characters long.
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your_secure_random_secret_key_minimum_32_characters_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:7860,http://127.0.0.1:7860

# WhatsApp Cloud API (Meta Developer)
# Leave blank to automatically use the high-fidelity simulated logger
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ADMIN_PHONE=+91 9691793254

# Twilio Credentials (Optional alternative WhatsApp provider)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Upload directory
UPLOAD_DIR=frontend/static/uploads/crop_images
